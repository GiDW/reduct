// Reduct.exe resources: icon, application manifest, version info and the
// settings dialog. build.rs compiles this with embed-resource; rc.exe gets
// this folder and OUT_DIR (for the generated version.h) as include paths.
#pragma code_page(65001)

#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_UK

// The exe icon: the lowest icon ID is the one Explorer shows.
IDI_APP ICON "../../../icon/ico/reduct.ico"

// ID 1 (CREATEPROCESS_MANIFEST_RESOURCE_ID): the loader reads it at start-up.
1 RT_MANIFEST "reduct.exe.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION REDUCT_VERSION_BIN
 PRODUCTVERSION REDUCT_VERSION_BIN
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // en-GB, Unicode
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "Oxyde"
            VALUE "FileDescription", "Reduct"
            VALUE "FileVersion", REDUCT_VERSION_STR
            VALUE "InternalName", "Reduct"
            VALUE "LegalCopyright", "Copyright (c) 2026 Gilles De Waele"
            VALUE "OriginalFilename", "Reduct.exe"
            VALUE "ProductName", "Reduct"
            VALUE "ProductVersion", REDUCT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END

// The combo box entries and the HEIC status text are filled in by src/ui.rs.
IDD_SETTINGS DIALOGEX 0, 0, 264, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Reduct settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "To optimise images, select them in File Explorer, right-click and choose Optimise with Reduct.",
                    IDC_HINT, 7, 7, 250, 20
    LTEXT           "Quality", IDC_STATIC, 7, 36, 108, 8
    EDITTEXT        IDC_QUALITY, 120, 34, 40, 14, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_QUALITY_SPIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_NOTHOUSANDS,
                    160, 34, 10, 14
    LTEXT           "Save to", IDC_STATIC, 7, 54, 108, 8
    COMBOBOX        IDC_SAVE_TO, 120, 52, 137, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "When the name is taken", IDC_STATIC, 7, 72, 108, 8
    COMBOBOX        IDC_NAME_TAKEN, 120, 70, 137, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Limit size", IDC_STATIC, 7, 90, 108, 8
    COMBOBOX        IDC_LIMIT_SIZE, 120, 88, 137, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Transparent areas", IDC_STATIC, 7, 108, 108, 8
    COMBOBOX        IDC_BACKGROUND, 120, 106, 137, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Keep the original file date", IDC_KEEP_DATE, 7, 128, 250, 10
    LTEXT           "", IDC_HEIC_STATUS, 7, 148, 250, 18
    PUSHBUTTON      "Get from Microsoft Store", IDC_HEIC_STORE, 7, 168, 110, 14
    PUSHBUTTON      "Licences", IDC_LICENCES, 7, 193, 60, 14
    DEFPUSHBUTTON   "OK", IDOK, 150, 193, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 207, 193, 50, 14
END

// The batch progress window (src/progress.rs): created hidden and shown once
// a batch has run for half a second. The buttons below Cancel start hidden
// (src/progress.rs hides them) and appear only on a result with errors.
IDD_PROGRESS DIALOGEX 0, 0, 260, 76
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Reduct"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Preparing…", IDC_PROGRESS_STATUS, 7, 7, 246, 10, SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL         "", IDC_PROGRESS_BAR, "msctls_progress32", 0x0, 7, 21, 246, 8
    LTEXT           "", IDC_PROGRESS_DETAIL, 7, 34, 246, 18, SS_NOPREFIX
    PUSHBUTTON      "Show details", IDC_SHOW_LOG, 49, 55, 60, 14
    PUSHBUTTON      "Get HEVC extension", IDC_GET_HEVC, 113, 55, 86, 14
    PUSHBUTTON      "Close", IDOK, 203, 55, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 55, 50, 14
END
